# Copy to .env for local dev (never commit .env). On Railway set these as service variables.
RESEND_API_KEY=re_xxx                       # full-access key (sends and reads received mail)
RESEND_WEBHOOK_SECRET=whsec_xxx             # from the Resend webhook's detail page
MAIL_FROM="CML Scheduler <cml@mail.example.org>"   # an address on your Resend domain; required for sending
ADMIN_EMAIL=you@example.edu                 # gets non-Sona mail (e.g. Gmail's forwarding confirmation) and problems
NO_SHOW_EMAIL=cogmodlab@gmail.com          # optional; gets "Mark As No-Show" reports (this is the default)
LAB_TIMEZONE=America/Los_Angeles           # optional; Sona times are in this zone (for the no-show timing check)
NO_SHOW_GRACE_MINUTES=5                     # optional; minutes after the start before a session can be marked a no-show
APP_URL=https://cml.example.org             # used for the calendar link in RA emails
CALENDAR_PASSWORD=change-me                 # shared password for RAs; leave unset to disable login (local only)
SECRET_KEY=long-random-string
# DATABASE_URL=postgresql://...             # Railway Postgres; omit to use SQLite in DATA_DIR
# DATA_DIR=/data                            # Railway volume mount path if using SQLite
# RA roster (required on Railway; locally a git-ignored ras.json works too). See ras.example.json for the format.
RA_CONFIG_JSON='{"TLS": {"name": "Taylor S.", "email": "tls@ucsc.edu"}, "MCP": {"name": "Morgan P.", "email": "mcp@ucsc.edu"}}'
